{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cartoon3d-engine/specs/chunk_input.schema.json",
  "title": "chunk_input",
  "description": "Một chunk do nhạc trưởng của video engine giao cho cartoon3d-engine. chunk_id = mốc mili-giây bắt đầu (9 chữ số) + số thứ tự (3 chữ số).",
  "type": "object",
  "required": ["chunk_id", "start_ms", "end_ms", "text", "emotion", "sensitivity", "style", "cast_refs"],
  "additionalProperties": false,
  "properties": {
    "chunk_id": {"type": "string", "pattern": "^[0-9]{9}_[0-9]{3}$"},
    "start_ms": {"type": "integer", "minimum": 0},
    "end_ms": {"type": "integer", "minimum": 1},
    "text": {"type": "string", "minLength": 1},
    "words": {
      "description": "Timeline từng từ (word-level SRT), mốc tuyệt đối theo tập, cùng gốc với start_ms/end_ms.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["w", "start_ms", "end_ms"],
        "additionalProperties": false,
        "properties": {
          "w": {"type": "string", "minLength": 1},
          "start_ms": {"type": "integer", "minimum": 0},
          "end_ms": {"type": "integer", "minimum": 0}
        }
      }
    },
    "emotion": {"type": "string", "enum": ["neutral", "calm", "tense", "reveal", "chaos", "sad", "funny"]},
    "sensitivity": {"type": "integer", "minimum": 0, "maximum": 3,
      "description": "0 không nhạy cảm · 1 nhẹ · 2 trung bình · 3 nặng. Do sensitive-term-audit gắn ở thượng nguồn."},
    "style": {"type": "string", "enum": ["toon", "voxel", "pixel3d"]},
    "cast_refs": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}, "uniqueItems": true},
    "set_hint": {"type": "string", "pattern": "^[a-z0-9_]+$", "description": "Bối cảnh gợi ý; bỏ trống thì shot_planner lấy default_set của nhân vật đầu tiên."},
    "fps": {"type": "integer", "enum": [24, 25, 30]},
    "notes": {"type": "string"}
  }
}
